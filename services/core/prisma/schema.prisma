generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  tasks        Task[]

  @@map("users") //maps an entire model to a database table.
}

model Task {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  title       String
  description String?
  status      String    @default("pending")
  priority    String    @default("medium")
  dueAt       DateTime? @map("due_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6) //prisma automatically generate updated timestamp
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade) // deleteing user deletes tasks

  @@index([userId, status]) // retrive all tasks of user
  @@index([userId, dueAt]) // retreive all task due
  @@map("tasks")
}
